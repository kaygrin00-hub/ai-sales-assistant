# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/telegram_mail_bot

# Mail.ru Settings
MAIL_RU_SMTP_HOST=smtp.mail.ru
MAIL_RU_SMTP_PORT=465
MAIL_RU_IMAP_HOST=imap.mail.ru
MAIL_RU_IMAP_PORT=993
MAIL_RU_DEFAULT_EMAIL=your_email@mail.ru
MAIL_RU_DEFAULT_PASSWORD=your_app_password

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# Features
ENABLE_NOTIFICATIONS=True
ENABLE_REMINDERS=True
CHECK_INTERVAL_MINUTES=5

# Security
ALLOWED_USERS=123456789,987654321
